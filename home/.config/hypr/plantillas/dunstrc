# Generado por tema.sh (tema {{id}}): no editar
[global]
    monitor = 0
    follow = mouse
    width = (300, 380)
    height = (0, 220)
    origin = top-right
    offset = (14, 14)
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4
    progress_bar_corners = all
    highlight = "#{{acento}}"
    indicate_hidden = yes
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#{{acento}}"
    gap_size = 8
    sort = yes
    idle_threshold = 120
    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    enable_recursive_icon_lookup = true
    icon_theme = {{iconos}}
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    sticky_history = yes
    history_length = 30
    dmenu = fuzzel --dmenu --config {{gen}}/fuzzel.ini -p "Acción  "
    browser = xdg-open
    always_run_script = true
    corner_radius = 14
    corners = all
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#{{bg}}ee"
    foreground = "#{{fg_dim}}"
    frame_color = "#{{borde}}"
    timeout = 4

[urgency_normal]
    background = "#{{bg}}ee"
    foreground = "#{{fg}}"
    frame_color = "#{{acento}}"
    timeout = 6

[urgency_critical]
    background = "#{{bg}}ee"
    foreground = "#{{fg}}"
    frame_color = "#{{urgente}}"
    highlight = "#{{urgente}}"
    timeout = 0

[osd]
    stack_tag = "osd"
    format = "<b>%s</b> %b"
    timeout = 2
