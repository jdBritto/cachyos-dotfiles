{
  "clock": {
    "format": "󰥔  {:%H:%M}",
    "format-alt": "󰃭  {:%A %d de %B  ·  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "",
