// Modulos de la barra, compartidos por los estilos "islas" y "panel".
{
  "modules-left": ["image#parrot", "group/escritorios", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "mpris", "tray", "group/sistema",
    "custom/modo", "custom/luz", "backlight", "pulseaudio", "network", "bluetooth", "battery",
    "custom/notificaciones", "custom/energia"
  ],

  "image#parrot": {
    "exec": "echo $HOME/.config/hypr/generado/parrot-logo.svg",
    "interval": 86400,
    "size": 18,
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/centro.sh",
    "on-click-right": "~/.config/hypr/scripts/tema.sh menu"
  },

  "group/escritorios": {
    "orientation": "horizontal",
    "modules": ["custom/esc1", "custom/esc2", "custom/esc3", "custom/esc4", "custom/esc5", "custom/escextra"]
  },
  "custom/esc1": {
    "exec": "~/.config/hypr/scripts/escritorios.sh 1", "return-type": "json", "interval": "once", "signal": 11,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
  },
  "custom/esc2": {
    "exec": "~/.config/hypr/scripts/escritorios.sh 2", "return-type": "json", "interval": "once", "signal": 11,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"
  },
  "custom/esc3": {
    "exec": "~/.config/hypr/scripts/escritorios.sh 3", "return-type": "json", "interval": "once", "signal": 11,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"
  },
  "custom/esc4": {
    "exec": "~/.config/hypr/scripts/escritorios.sh 4", "return-type": "json", "interval": "once", "signal": 11,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'"
  },
  "custom/esc5": {
    "exec": "~/.config/hypr/scripts/escritorios.sh 5", "return-type": "json", "interval": "once", "signal": 11,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"
  },
  "custom/escextra": {
    "exec": "~/.config/hypr/scripts/escritorios.sh extra", "return-type": "json", "interval": "once", "signal": 11
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 48,
    "separate-outputs": true,
    "icon": true,
    "icon-size": 16,
    "rewrite": { "": "Escritorio" }
  },

  "mpris": {
    "format": "{player_icon}  {title}",
    "format-paused": "{status_icon}  <i>{title}</i>",
    "player-icons": { "default": "󰎆", "firefox": "󰈹", "spotify": "󰓇", "mpv": "󰐹" },
    "status-icons": { "paused": "󰏤" },
    "title-len": 26,
    "tooltip-format": "{player}: {artist} - {title}\nClic: pausa · Rueda: cambiar"
  },

  "tray": { "icon-size": 16, "spacing": 8 },

  "group/sistema": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 300, "transition-left-to-right": false, "children-class": "oculto" },
    "modules": ["cpu", "memory", "custom/temperatura", "disk"]
  },
  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 3,
    "on-click": "~/.config/hypr/scripts/terminal.sh --title Tareas -e btop",
    "tooltip-format": "Procesador: {usage}%\nPasa el ratón para ver más"
  },
  "memory": { "format": "󰍛 {percentage}%", "interval": 5, "tooltip-format": "Memoria: {used:0.1f} de {total:0.1f} GiB" },
  "custom/temperatura": { "exec": "~/.config/hypr/scripts/temperatura.sh", "return-type": "json", "interval": 10 },
  "disk": { "format": "󰋊 {percentage_used}%", "path": "/", "tooltip-format": "Disco: {used} de {total}" },

  "custom/modo": {
    "exec": "~/.config/hypr/scripts/modo.sh estado",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "~/.config/hypr/scripts/modo.sh ciclar"
  },
  "custom/luz": {
    "exec": "~/.config/hypr/scripts/luz.sh estado",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "on-click": "~/.config/hypr/scripts/luz.sh alternar"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "~/.config/hypr/scripts/osd.sh brillo+",
    "on-scroll-down": "~/.config/hypr/scripts/osd.sh brillo-",
    "tooltip-format": "Brillo: {percent}%"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 mudo",
    "format-bluetooth": "󰂰 {volume}%",
    "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "~/.config/hypr/scripts/osd.sh silencio",
    "tooltip-format": "{desc}: {volume}%\nClic: mezclador · Clic derecho: silenciar"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}\nClic: elegir red",
    "tooltip-format-ethernet": "Cable: {ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Sin conexión\nClic: elegir red",
    "on-click": "~/.config/hypr/scripts/wifi.sh",
    "on-click-right": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },
  "battery": {
    "states": { "aviso": 25, "critico": 12 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\nConsumo: {power} W"
  },
  "custom/notificaciones": {
    "exec": "~/.config/hypr/scripts/notificaciones.sh estado",
    "return-type": "json",
    "interval": 5,
    "signal": 10,
    "on-click": "~/.config/hypr/scripts/notificaciones.sh historial",
    "on-click-right": "~/.config/hypr/scripts/notificaciones.sh no-molestar"
  },
  "custom/energia": {
    "format": "󰐥",
    "tooltip-format": "Apagar, reiniciar, bloquear...",
    "on-click": "~/.config/hypr/scripts/energia.sh"
  }
}
